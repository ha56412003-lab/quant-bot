# ============================================================
#  Quant Bot 配置模板
#  复制这个文件为 .env,然后填上你自己的 key
#  Windows 命令:  copy .env.example .env
# ============================================================

# ---------- 数据服务(免费) ----------
# 注册地址: https://openclawby.com  (邮箱或钱包登录,免费拿 key)
# 不填也能启动,但 56 个因子里依赖 Clawby 的那部分会没有数据
CLAWBY_API_KEY=
CLAWBY_BASE=https://api.openclawby.com

# ---------- 币安(实盘下单才需要) ----------
# 模拟盘不用填。实盘时务必:关闭提现权限 + 绑定 IP 白名单
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# ---------- Bitget(可选) ----------
BITGET_API_KEY=
BITGET_SECRET_KEY=
BITGET_PASSPHRASE=

# ---------- OKX(可选) ----------
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

# ---------- 运行参数 ----------
# 模拟盘初始虚拟本金(USDT)
QB_PAPER_BALANCE=10000

# ---------- API 访问控制 ----------
# Host 白名单(逗号分隔)。默认只允许本机访问。
# 这个白名单挡的是 DNS rebinding 攻击:攻击者把自己的域名解析到
# 127.0.0.1,浏览器认为同源,但 Host 头是攻击者域名 —— 一样会被拒。
#
# 上云服务器时,必须把公网域名/IP 加进来,否则全部请求返回 403。
# 例: QB_API_ALLOWED_HOSTS=127.0.0.1,localhost,quant.yourdomain.com
QB_API_ALLOWED_HOSTS=127.0.0.1,localhost,::1

# 写操作令牌。留空 = 不校验(仅适合本机使用)。
# 一旦把服务暴露到公网,必须设置一个长随机串,否则谁能访问 URL
# 谁就能一键清仓、改风控参数、切实盘。
# 生成方法: python -c "import secrets; print(secrets.token_urlsafe(32))"
# 前端调用写接口时带 X-API-Token 头即可。
QB_API_TOKEN=

# 数据库位置(留空则放在项目根目录)
QB_DB_PATH=

# 监控币池(逗号分隔,留空则用 strategies.yaml 里的)
QB_UNIVERSE=
